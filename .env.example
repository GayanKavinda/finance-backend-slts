APP_NAME="FinancePro"
# local | production | staging
APP_ENV=local
APP_KEY=
# MUST be false in production
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Set to 'error' in production
LOG_LEVEL=debug

# ── Database (MySQL) ───────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance-app
DB_USERNAME=root
# REQUIRED in production — must not be empty
DB_PASSWORD=

# ── Session ────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# ── Sanctum / CORS ─────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to send cookies
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use 'redis' in production for async queue processing
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ───────────────────────────────────────────────────────────
# Use 'smtp', 'mailgun', or 'ses' in production — NOT 'log'
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sltservices.lk"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (optional — only if using S3 for file storage) ────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Frontend ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3100

VITE_APP_NAME="${APP_NAME}"
